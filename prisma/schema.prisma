// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  discordId String   @unique // 디스코드 사용자 ID
  username  String // 디스코드 사용자 이름
  x         Int // X 좌표
  y         Int // Y 좌표
  minPower  BigInt? // 바바리안 최소 파워 (필터용)
  maxPower  BigInt? // 바바리안 최대 파워 (필터용)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Player Watch 설정 (마지막으로 사용된 설정 저장)
// 단일 row(id=1)만 사용하는 싱글톤 형태 - 가장 최근 Watch 설정 저장
// !watchresume 명령어로 이 설정을 다시 로드해 Watch 재개
model PlayerWatchConfig {
  id        Int      @id @default(1) // 싱글톤 (항상 id=1)
  minPower  Int // M 단위 최소 파워
  maxPower  Int // M 단위 최대 파워
  names     String // 감시 대상 이름들 (JSON array string)
  channelId String // 알림 보낼 디스코드 채널 ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
