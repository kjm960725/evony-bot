{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🔥 Discord Bot (Hot Reload)",
      "type": "node",
      "request": "launch",
      "program": "node_modules/ts-node-dev/lib/bin.js",
      "args": ["--respawn", "--transpile-only", "src/index.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🤖 Discord Bot Debug",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-r", "ts-node/register"],
      "args": ["./src/index.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
